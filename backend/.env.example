# Copy this file to backend/.env and fill in your own values.
# Generate unique secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
# Optional. Without it, the AI assistant endpoint returns HTTP 503.
OPENROUTER_API_KEY=
# Optional, defaults to a local SQLite database.
# SQLALCHEMY_DATABASE_URI=sqlite:///site.db
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# OROGENIE_DEBUG=false
